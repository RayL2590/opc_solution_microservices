# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Environment files with real secrets — never commit them.
# The secret-free templates ".env.example" / ".env.docker.example" stay tracked.
.env
*.env
.env.docker
!.env.example
!.env.docker.example

# BMAD / Claude tooling and generated artifacts (not part of the project itself)
.claude/
_bmad/
_bmad-output/
.agents/

# Local notes and documentation (not part of the project deliverable)
docs/

# Scratch/build output — working files, never part of the deliverable
tmp/
output/
target/