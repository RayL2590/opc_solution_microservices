# Environment variable surface for the medilabo microservices platform (NFR-S3).
# Copy this file to ".env", fill in the REAL values, and never commit ".env" — it is git-ignored.
# This template is the single source of truth for every secret/config the services consume.
# No real secret must ever appear in this file.

# --- patient-service / MySQL (consumed in Story 1.2) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/patientdb?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=patientdb
SPRING_DATASOURCE_PASSWORD=change-me

# --- mysql container bootstrap (consumed by the compose `mysql` service, Story 6.2) ---
# MYSQL_USER/MYSQL_PASSWORD should match SPRING_DATASOURCE_USERNAME/PASSWORD above.
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_DATABASE=patientdb
MYSQL_USER=patientdb
MYSQL_PASSWORD=change-me

# --- notes-service / MongoDB (documented now, consumed in Epic 3) ---
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/notesdb

# --- HUMAN account — the clinician logging into front-service (Stories 1.4 / 2.4 / 3.4 / 4.4 / 5.1).
#     Accepted by every service. NEVER used for service-to-service calls since Story 7.1. ---
MEDILABO_USER=medilabo
# BCrypt HASH only — never plaintext.
MEDILABO_PASSWORD_BCRYPT=$2a$10$replace-with-a-real-bcrypt-hash

# --- SERVICE accounts (Story 7.1) — one per calling service, decorrelated from the human account
#     so the clinician's password never travels between services.
#     Three vars each: the CALLER builds its Basic header from the raw _PASSWORD; every
#     callee's SecurityConfig stores only the _PASSWORD_BCRYPT hash. Keep the pair in sync —
#     _PASSWORD_BCRYPT must be the BCrypt hash of _PASSWORD or every outbound call 401s.
#     MEDILABO_SVC_FRONT_PASSWORD and MEDILABO_SVC_ASSESSMENT_PASSWORD are REQUIRED: they have
#     no default in application.properties (a committed plaintext secret is a public secret),
#     so front-service and assessment-service refuse to start without them. ---
MEDILABO_SVC_FRONT_USER=svc-front
MEDILABO_SVC_FRONT_PASSWORD=change-me
MEDILABO_SVC_FRONT_PASSWORD_BCRYPT=$2a$10$replace-with-a-real-bcrypt-hash

MEDILABO_SVC_ASSESSMENT_USER=svc-assessment
MEDILABO_SVC_ASSESSMENT_PASSWORD=change-me
MEDILABO_SVC_ASSESSMENT_PASSWORD_BCRYPT=$2a$10$replace-with-a-real-bcrypt-hash

# --- Gateway base URI for assessment-service & front-service RestClient (consumed in Epics 4/5) ---
GATEWAY_URI=http://localhost:8080
